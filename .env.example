# Zettelkasten MCP Server Configuration

ZETTELKASTEN_NOTES_DIR=./data/notes
ZETTELKASTEN_DATABASE_PATH=./data/db/zettelkasten.db
ZETTELKASTEN_LOG_LEVEL=INFO

# FTS5 Full-Text Search (porter stemming + BM25 ranking — enabled by default)
USE_FTS5_SEARCH=true

# LLM Summary Generation (Azure OpenAI — disabled by default)
# Generates English summaries and keywords for cross-language FTS5 search.
# Requires azure-identity and openai packages: uv add openai azure-identity
LLM_ENABLE_SUMMARIES=false
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
