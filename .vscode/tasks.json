{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "uv",
            "args": [
                "sync",
                "--dev"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "-v"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests with Coverage",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "--cov=zettelkasten_mcp",
                "--cov-report=html",
                "--cov-report=term-missing"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Lint with Ruff",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "check",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "ruff",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(.+)\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Format with Ruff",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "format",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Type Check with MyPy",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "mypy",
                "src/"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "mypy",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Security Check with Bandit",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "bandit",
                "-r",
                "src/"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Check Dependencies with Safety",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "safety",
                "check"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run MCP Server",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "zettelkasten_mcp"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Full Quality Check",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Lint with Ruff",
                "Type Check with MyPy",
                "Security Check with Bandit",
                "Run Tests with Coverage"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean Build Artifacts",
            "type": "shell",
            "command": "find",
            "args": [
                ".",
                "-name",
                "__pycache__",
                "-type",
                "d",
                "-exec",
                "rm",
                "-rf",
                "{}",
                "+",
                "||",
                "true"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Pre-commit",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pre-commit",
                "install"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "ZK: Search Notes",
            "detail": "Requires ZETTELKASTEN_NOTES_DIR and ZETTELKASTEN_DATABASE_PATH in .env or environment",
            "type": "shell",
            "command": "uv run python -c \"\nimport os\nfrom zettelkasten_mcp.storage.note_repository import NoteRepository\nr = NoteRepository()\nq = '${input:zkQuery}'.lower()\nnotes = [n for n in r.search() if q in n.title.lower() or q in n.content.lower() or any(q in t.name for t in n.tags)]\nnotes.sort(key=lambda n: n.updated_at, reverse=True)\n[print(f'{n.id}.md  [{n.note_type.value:12}]  {n.title}') for n in notes]\nprint(f'\\n{len(notes)} result(s) for: ${input:zkQuery}')\n\"",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "ZK: Search by Tag",
            "detail": "Requires ZETTELKASTEN_NOTES_DIR and ZETTELKASTEN_DATABASE_PATH in .env or environment",
            "type": "shell",
            "command": "uv run python -c \"\nfrom zettelkasten_mcp.storage.note_repository import NoteRepository\nr = NoteRepository()\nnotes = r.search(tags=['${input:zkTag}'])\nnotes.sort(key=lambda n: n.updated_at, reverse=True)\n[print(f'{n.id}.md  [{n.note_type.value:12}]  {n.title}') for n in notes]\nprint(f'\\n{len(notes)} result(s) for tag: ${input:zkTag}')\n\"",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "ZK: List All Tags",
            "detail": "Requires ZETTELKASTEN_NOTES_DIR and ZETTELKASTEN_DATABASE_PATH in .env or environment",
            "type": "shell",
            "command": "uv run python -c \"\nfrom zettelkasten_mcp.storage.note_repository import NoteRepository\nfrom collections import Counter\nr = NoteRepository()\nnotes = r.search()\ntag_counts = Counter(t.name for n in notes for t in n.tags)\n[print(f'{count:3}  {tag}') for tag, count in sorted(tag_counts.items())]\nprint(f'\\n{len(tag_counts)} tags across {len(notes)} notes')\n\"",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "ZK: List Recent Notes",
            "detail": "Requires ZETTELKASTEN_NOTES_DIR and ZETTELKASTEN_DATABASE_PATH in .env or environment",
            "type": "shell",
            "command": "uv run python -c \"\nfrom zettelkasten_mcp.storage.note_repository import NoteRepository\nr = NoteRepository()\nnotes = sorted(r.search(), key=lambda n: n.updated_at, reverse=True)[:20]\n[print(f'{str(n.updated_at)[:16]}  {n.id}.md  [{n.note_type.value:12}]  {n.title}') for n in notes]\n\"",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "zkQuery",
            "type": "promptString",
            "description": "Search term (searches note titles, content and tags)"
        },
        {
            "id": "zkTag",
            "type": "promptString",
            "description": "Tag to filter by (e.g. multi-agent, security, 2026)"
        }
    ]
}
